APP_NAME="OZ Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Hostnames for each part of the app. Leave empty locally: everything then
# answers on APP_URL, with the admin at /admin and the studio at /studio.
# Production: ozmedianet.com, admin.ozmedianet.com, studio.ozmedianet.com
MAIN_DOMAIN=
ADMIN_DOMAIN=
STUDIO_DOMAIN=

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oz_media_laravel
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production: .ozmedianet.com so one login works on the site, admin and studio.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Admin uploads are shown on the public site, so they use the public disk.
FILAMENT_FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: `log` writes emails to storage/logs. Production: smtp (see README "Email").
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ozmedianet.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The house ad under the player (when a station has no sponsor banner) links here.
ADVERTISING_EMAIL=marketing@ozmedianet.com

# First `dev` admin, created by `php artisan db:seed` (local falls back to "password")
ADMIN_EMAIL=
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# The mobile app's Google OAuth client ids (Android, iOS), comma separated.
GOOGLE_APP_CLIENT_IDS=

# Self-hosted Umami (optional)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_SHARE_URL=

# Optional: Icecast admin login, for player types (smart speakers, radio apps) in Analytics > Devices.
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=
